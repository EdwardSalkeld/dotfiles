{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(~/.claude/skills/**)",
      "Read(~/.claude/settings.json)",
      "Read(~/personal/work-brain/**)",
      "Write(~/personal/work-brain/**)",
      "Edit(~/personal/work-brain/**)",
      "Bash(git -C /Users/edsalkeld/personal/work-brain *)",
      "Bash(gh api *)",
      "Bash(gh repo view *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-inbox-hook",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-inbox-hook",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-inbox-hook",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-inbox-hook",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/claude-inbox-hook",
            "async": true
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": true
}
