#!/usr/bin/env bash
# Grow the current task to span another repo: add a worktree (same branch) into
# the current task dir and open a window for it. Run from inside a task session.
#
#   expand-session          -> fzf pick a repo not already in the task
#   expand-session <repo>
set -euo pipefail

CODE="$HOME/code"
WT="$HOME/worktrees"
[ -n "${TMUX:-}" ] || { echo "expand-session: not in a tmux session"; exit 1; }

sess="$(tmux display-message -p '#S')"
taskdir="$WT/$sess"
[ -d "$taskdir" ] || { tmux display-message "expand-session: '$sess' isn't a task ($taskdir missing)"; exit 1; }

# branch: whatever the task's existing worktree(s) are on
first="$(find "$taskdir" -mindepth 1 -maxdepth 1 -type d | head -1)"
branch="$(git -C "$first" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"

repo="${1:-}"
if [ -z "$repo" ]; then
  repo=$( find "$CODE" -mindepth 1 -maxdepth 1 -type d -exec test -e '{}/.git' ';' -print \
          | sed 's#.*/##' \
          | while read -r b; do [ -e "$taskdir/$b" ] || echo "$b"; done \
          | sort | fzf --tmux --prompt="add repo to $sess > " ) || exit 0
fi
[ -z "$repo" ] && exit 0
[ -e "$taskdir/$repo" ] && { tmux display-message "$repo already in $sess"; exit 0; }

git -C "$CODE/$repo" worktree add "$taskdir/$repo" -b "$branch" 2>/dev/null \
  || git -C "$CODE/$repo" worktree add "$taskdir/$repo" "$branch"
tmux new-window -t "$sess" -c "$taskdir/$repo" -n "$repo"
tmux display-message "added $repo to $sess (branch $branch)"
