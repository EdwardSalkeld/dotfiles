#!/usr/bin/env bash
# Tear down a task: force-remove the worktree(s) in its session dir (+ their
# branches), delete the dir, and end the tmux session. Destroys unconditionally
# — push anything worth keeping first.
# Usage: teardown-session [task]   (task defaults to the current session)
set -uo pipefail

SESSIONS="$HOME/sessions"

# ignore a stray --force (old habit); take the task name
task=""
for a in "$@"; do [ "$a" = --force ] || task="$a"; done
[ -z "$task" ] && task="$(tmux display-message -p '#S' 2>/dev/null)"

taskdir="$SESSIONS/$task"
[ -d "$taskdir" ] || { echo "not a task session (no $taskdir)"; exit 1; }

# The source repo of a worktree — its main working tree, however the dir is named.
repo_root_of() { git -C "$1" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}'; }

for wt in "$taskdir"/*/; do
  [ -e "$wt/.git" ] || continue
  root="$(repo_root_of "$wt")"
  [ -n "$root" ] || continue
  branch="$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  git -C "$root" worktree remove --force "$wt" 2>/dev/null
  [ -n "$branch" ] && [ "$branch" != HEAD ] && git -C "$root" branch -D "$branch" >/dev/null 2>&1
  git -C "$root" worktree prune 2>/dev/null
done
rm -rf "$taskdir"

# End the session (tmux moves the client to another session, or exits if last).
tmux kill-session -t "$task" 2>/dev/null || true
