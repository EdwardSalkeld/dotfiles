#!/usr/bin/env bash
# Tidy git repos: either every non-worktree repo under a directory, or a single
# repo if pointed straight at one.
#
# Pruning (default, and with --hard):
#   1. remove clean linked worktrees (git worktree remove, never --force, so a
#      worktree with local or untracked changes is left untouched)
#   2. prune stale worktree admin data (git worktree prune)
#   3. delete local branches:
#        - default: only those safe to drop (fully pushed, or already merged
#          into the default branch incl. squash-merges)
#        - --hard:  every other branch, force-deleted, pushed or not
#   4. log branches that survive
#
# Freshening (--fresh / --hard):
#   - switch to the default branch, if the working tree is clean
#   - (--fresh only) pull the default branch fast-forward-only
#
# --fresh on its own ONLY freshens: no worktree removal, no branch pruning.
# Combine with --hard to freshen and prune together.
#
# --status just reports each repo's branch, last-commit date, and how it sits
# vs upstream (from the last fetch); read-only, ignores the other flags.
# --json is the same report as one JSON object, for tools that drive this script.
#
# Nothing is changed without -x; on its own the script only previews.
#   tidy-repos [dir]                  -> preview over dir (default: cwd)
#   tidy-repos --status [dir]         -> show branch, last commit, sync vs upstream
#   tidy-repos --json [dir]           -> the same status as JSON
#   tidy-repos -x [dir]               -> remove clean worktrees + safe branches
#   tidy-repos -x --fresh [dir]       -> ONLY switch to default branch and pull
#   tidy-repos -x --hard  [dir]       -> prune, nuking every non-default branch
#   tidy-repos -x --fresh --hard [dir]-> freshen and hard-prune
set -euo pipefail

dry=1; fresh=0; hard=0; status=0; json=0; root=""
for a in "$@"; do
  case "$a" in
    -x)       dry=0 ;;
    --fresh)  fresh=1 ;;
    --hard)   hard=1 ;;
    --status) status=1 ;;
    --json)   json=1 ;;
    -h|--help) sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)       echo "tidy-repos: unknown flag: $a" >&2; exit 1 ;;
    *)        root="$a" ;;
  esac
done
root="${root:-$PWD}"
[ -d "$root" ] || { echo "tidy-repos: no such dir: $root" >&2; exit 1; }

bold=$'\e[1m'; dim=$'\e[2m'; yellow=$'\e[33m'; green=$'\e[32m'; reset=$'\e[0m'

# Is $branch already merged into $mainref, even via squash? Rebuild the branch
# as a single commit on top of its merge-base, then let git cherry check whether
# a patch-equivalent commit already exists upstream (a leading '-' means yes).
squash_merged() {
  local repo="$1" branch="$2" mainref="$3" base tree synth
  base="$(git -C "$repo" merge-base "$mainref" "$branch" 2>/dev/null)" || return 1
  tree="$(git -C "$repo" rev-parse "$branch^{tree}" 2>/dev/null)" || return 1
  synth="$(git -C "$repo" commit-tree "$tree" -p "$base" -m _ 2>/dev/null)" || return 1
  case "$(git -C "$repo" cherry "$mainref" "$synth" 2>/dev/null)" in
    -*) return 0 ;;
    *)  return 1 ;;
  esac
}

# Read-only one-liner: repo name, HEAD commit date, and how the current branch
# sits vs its upstream. The sync state uses the last-fetched remote refs (this
# does not fetch), so run a fetch, --fresh, or a plain tidy first for freshness.
show_status() {
  repo="$1"
  br="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || echo '(detached)')"
  when="$(git -C "$repo" log -1 --format='%cd' --date=format:'%Y-%m-%d' 2>/dev/null || echo '-')"
  rel="$(git -C "$repo" log -1 --format='%cr' 2>/dev/null || echo '')"

  local sync col="$dim"
  if up="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
    read -r ahead behind < <(git -C "$repo" rev-list --left-right --count "HEAD...$up" 2>/dev/null || echo "0 0")
    if [ "${ahead:-0}" = 0 ] && [ "${behind:-0}" = 0 ]; then sync="up to date"
    elif [ "${ahead:-0}" != 0 ] && [ "${behind:-0}" != 0 ]; then sync="ahead $ahead, behind $behind"; col="$yellow"
    elif [ "${behind:-0}" != 0 ]; then sync="behind $behind"; col="$yellow"
    else sync="ahead $ahead"; col="$yellow"; fi
  else
    sync="no upstream"
  fi

  printf '%-32s %-11s %-22s %b%-18s%b %s\n' \
    "${repo##*/}" "$when" "$rel" "$col" "$sync" "$reset" "$br"
}

# The same facts as show_status, plus a dirty flag and worktree count, as one
# JSON object per repo. Written for the tidy-ui frontend; keep the keys stable.
json_esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

json_first=1
json_status() {
  repo="$1"
  br="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || echo '')"
  when="$(git -C "$repo" log -1 --format='%cd' --date=format:'%Y-%m-%d' 2>/dev/null || echo '')"
  rel="$(git -C "$repo" log -1 --format='%cr' 2>/dev/null || echo '')"
  up="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo '')"
  ahead=0; behind=0
  [ -n "$up" ] && read -r ahead behind < <(git -C "$repo" rev-list --left-right --count "HEAD...$up" 2>/dev/null || echo "0 0")
  dirty=false
  [ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ] && dirty=true
  # worktree list always includes the main checkout, so linked ones are count-1.
  worktrees="$(git -C "$repo" worktree list --porcelain 2>/dev/null | grep -c '^worktree ' || true)"
  worktrees=$(( worktrees > 0 ? worktrees - 1 : 0 ))
  branches="$(git -C "$repo" for-each-ref --format='x' refs/heads/ 2>/dev/null | grep -c . || true)"

  [ "$json_first" = 1 ] || printf ',\n'
  json_first=0
  printf '{"name":"%s","path":"%s","branch":"%s","date":"%s","relative":"%s","upstream":"%s","ahead":%d,"behind":%d,"dirty":%s,"worktrees":%d,"branches":%d}' \
    "$(json_esc "${repo##*/}")" "$(json_esc "$repo")" "$(json_esc "$br")" \
    "$(json_esc "$when")" "$(json_esc "$rel")" "$(json_esc "$up")" \
    "${ahead:-0}" "${behind:-0}" "$dirty" "$worktrees" "${branches:-0}"
}

tidy_repo() {
  repo="$1"
  echo "${bold}${repo##*/}${reset}"

  # --fresh on its own only freshens; the pruning steps are skipped.
  cleanup=1
  [ "$fresh" = 1 ] && [ "$hard" = 0 ] && cleanup=0

  git -C "$repo" fetch --quiet --prune 2>/dev/null || echo "  ${yellow}fetch failed (offline?)${reset}"

  if [ "$cleanup" = 1 ]; then
    # Remove clean linked worktrees. Never --force: git refuses to remove a
    # worktree with modified or untracked files, so nothing unsaved is lost.
    while read -r wt; do
      [ -f "$wt/.git" ] || continue   # only linked worktrees, never the main checkout
      name="${wt##*/}"
      if [ "$dry" = 1 ]; then
        if [ -z "$(git -C "$wt" status --porcelain 2>/dev/null)" ]; then
          echo "  ${dim}would remove worktree${reset} $name"
        else
          echo "  ${yellow}keep worktree (local changes)${reset} $name"
        fi
      elif git -C "$repo" worktree remove "$wt" 2>/dev/null; then
        echo "  ${green}removed worktree${reset} $name"
      else
        echo "  ${yellow}kept worktree (local changes)${reset} $name"
      fi
    done < <(git -C "$repo" worktree list --porcelain | sed -n 's#^worktree ##p')

    git -C "$repo" worktree prune
  fi

  # Default branch name (local short form).
  def="$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  defbranch="${def#origin/}"
  if [ -z "$defbranch" ]; then
    for c in main master; do
      git -C "$repo" rev-parse --verify --quiet "refs/heads/$c" >/dev/null 2>&1 && { defbranch="$c"; break; }
    done
  fi

  # The current branch of the main checkout (empty if detached).
  curbranch="$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"

  # --fresh / --hard both need us on the default branch: --fresh to pull it,
  # --hard so the previously-checked-out branch becomes deletable.
  switched_away=0
  if { [ "$fresh" = 1 ] || [ "$hard" = 1 ]; } && [ -n "$defbranch" ] \
     && [ -n "$curbranch" ] && [ "$curbranch" != "$defbranch" ]; then
    if [ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ]; then
      echo "  ${yellow}not switching to $defbranch (working tree dirty)${reset}"
    elif [ "$dry" = 1 ]; then
      echo "  ${dim}would switch to${reset} $defbranch"
      switched_away=1
    elif git -C "$repo" switch "$defbranch" >/dev/null 2>&1; then
      echo "  ${green}switched to${reset} $defbranch"
      switched_away=1
    else
      echo "  ${yellow}could not switch to $defbranch${reset}"
    fi
  fi

  # --fresh: fast-forward the default branch (only meaningful once we're on it).
  if [ "$fresh" = 1 ] && [ -n "$defbranch" ]; then
    if [ "$dry" = 1 ]; then
      echo "  ${dim}would pull --ff-only${reset} $defbranch"
    elif [ "$switched_away" = 1 ] || [ "$curbranch" = "$defbranch" ]; then
      if git -C "$repo" pull --ff-only --quiet 2>/dev/null; then
        echo "  ${green}pulled${reset} $defbranch"
      else
        echo "  ${yellow}pull skipped (not fast-forward or offline)${reset}"
      fi
    fi
  fi

  if [ "$cleanup" = 1 ]; then
    # Never delete: default branch, and any branch checked out in a *linked*
    # worktree. The main checkout's current branch is protected too, unless we
    # switched (or would switch) away from it.
    protected=" main  master "
    [ -n "$defbranch" ] && protected="$protected $defbranch "
    [ "$switched_away" = 0 ] && [ -n "$curbranch" ] && protected="$protected $curbranch "
    main_seen=0
    while read -r key val; do
      case "$key" in
        worktree) : ;;
        branch)
          b="${val#refs/heads/}"
          if [ "$main_seen" = 0 ]; then main_seen=1; else protected="$protected $b "; fi ;;
      esac
    done < <(git -C "$repo" worktree list --porcelain)

    # Ref to test merges against: prefer the remote default branch, else local.
    mainref="$def"
    [ -n "$mainref" ] && ! git -C "$repo" rev-parse --verify --quiet "$mainref^{commit}" >/dev/null 2>&1 && mainref=""
    if [ -z "$mainref" ]; then
      for c in origin/main origin/master main master; do
        git -C "$repo" rev-parse --verify --quiet "$c^{commit}" >/dev/null 2>&1 && { mainref="$c"; break; }
      done
    fi

    leftover=""
    while read -r branch; do
      [ -z "$branch" ] && continue
      case "$protected" in *" $branch "*) continue ;; esac

      reason=""
      if [ "$hard" = 1 ]; then
        reason="hard"
      else
        tip="$(git -C "$repo" rev-parse "$branch")"
        if git -C "$repo" branch -r --contains "$tip" 2>/dev/null | grep -q .; then
          reason="pushed"
        elif [ -n "$mainref" ] && squash_merged "$repo" "$branch" "$mainref"; then
          reason="merged"
        fi
      fi

      if [ -n "$reason" ]; then
        if [ "$dry" = 1 ]; then
          echo "  ${dim}would delete${reset} $branch ${dim}($reason)${reset}"
        else
          git -C "$repo" branch -D "$branch" >/dev/null
          echo "  ${green}deleted${reset} $branch ${dim}($reason)${reset}"
        fi
      else
        leftover="$leftover$branch"$'\n'
      fi
    done < <(git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads/)

    if [ -n "$leftover" ]; then
      echo "  ${yellow}kept (unpushed):${reset}"
      printf '%s' "$leftover" | while read -r b; do echo "    $b"; done
    fi
  fi

  # Pack loose objects into the repo's pack. Reading thousands of loose object
  # files is very slow over a network / virtiofs mount — each is a separate
  # round-trip — so keeping repos packed keeps clones from them fast. git's own
  # auto-gc only fires at 6700 loose objects, too high to help in practice.
  if [ "$dry" = 1 ]; then
    echo "  ${dim}would gc${reset}"
  elif git -C "$repo" gc --quiet 2>/dev/null; then
    echo "  ${green}packed${reset}"
  fi

  echo
}

# Pick the per-repo action; --status and --json short-circuit the tidying.
action=tidy_repo
[ "$status" = 1 ] && action=show_status
[ "$json" = 1 ] && action=json_status

[ "$json" = 1 ] && printf '{"root":"%s","repos":[\n' "$(json_esc "$root")"

# A main clone has .git as a directory; a linked worktree has it as a file.
if [ -d "$root/.git" ]; then
  "$action" "$root"
else
  for repo in "$root"/*/; do
    repo="${repo%/}"
    [ -d "$repo/.git" ] || continue
    "$action" "$repo"
  done
fi

[ "$json" = 1 ] && printf '\n]}\n'
