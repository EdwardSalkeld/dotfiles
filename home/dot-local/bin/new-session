#!/usr/bin/env bash
# Start a task: a tmux session backed by a fresh ~/sessions/<task> workspace.
# The dir gets an AGENTS.md telling the agent the working agreement — code lives
# in ~/code, work happens on git worktrees created into the session dir. Worktree
# management is the agent's job; this script just makes the space and opens tmux.
#
#   new-session                 -> type a label
#   new-session <label>
#   new-session <existing-dir>  -> legacy: just open a plain session in that dir
set -euo pipefail

SESSIONS="$HOME/sessions"

open() { # $1 = session name, $2 = start dir
  tmux has-session -t "$1" 2>/dev/null || tmux new-session -ds "$1" -c "$2"
  if [ -z "${TMUX:-}" ]; then exec tmux attach -t "$1"; else exec tmux switch-client -t "$1"; fi
}

# legacy: a path to an existing dir -> plain session there (e.g. ~/personal/notes)
if [ "${1:-}" ] && [ -d "$1" ]; then
  open "$(basename "$1" | tr . _)" "$1"
fi

# label (free text via fzf's query when not given). fzf exits non-zero when the
# typed query matches nothing (normal here) — don't let set -e kill us.
label="${1:-}"
if [ -z "$label" ]; then
  label=$( </dev/null fzf --tmux --print-query --prompt='new task > ' | head -1 ) || true
fi
label="${label// /-}"
[ -z "$label" ] && exit 0

task="$(date +%y%m%d)-$label"
taskdir="$SESSIONS/$task"
mkdir -p "$taskdir"

# Working agreement for the agent. Written once so re-running is harmless.
if [ ! -e "$taskdir/AGENTS.md" ]; then
  cat > "$taskdir/AGENTS.md" <<'AGENTS'
# This is a task session

Your workspace is this directory. Do your work here.

## Where the code is
All repositories live under `~/code/<repo>`. Treat `~/code` as **read-only
reference** — never edit, commit, or branch there directly.

To change a repo, create a git **worktree** of it into this session dir:

    git -C ~/code/<repo> worktree add "$PWD/<repo>" -b <branch>    # new branch
    git -C ~/code/<repo> worktree add "$PWD/<repo>" <existing>     # existing branch

Name the worktree dir after the repo; add one per repo if the task spans several.

## Databases
If a repo uses a local per-worktree DB, seed it after creating the worktree:
run `wt-db load` inside it (`wt-db promote` snapshots the current DB as the seed).

## Before you finish
Commit and **push** your branch(es). Teardown refuses on uncommitted/unpushed
work, and these working dirs are wiped on a box recreate (commits are safe in
`~/code/<repo>/.git`; uncommitted working state is not).
AGENTS
fi

open "$task" "$taskdir"
