#!/usr/bin/env bash
# Move to a task view — any existing session dir (~/sessions) or live tmux
# session, most-recently-used first. Switches if it's running, resumes it (opens
# a session in the dir) if not — so tasks survive a box restart. The fzf preview
# shows what each task is doing (live: its panes; stopped: worktree git status).
# ctrl-n starts a new task.
set -uo pipefail
SESSIONS="$HOME/sessions"

# --- preview mode: fzf calls `swap-session --preview <name>` for the highlight
if [ "${1:-}" = "--preview" ]; then
  name="${2:-}"
  if tmux has-session -t "$name" 2>/dev/null; then
    printf '● running\n\n'
    tmux list-panes -s -t "$name" \
      -F '  #{window_index}.#{pane_index}  [#{pane_current_command}]  #{pane_title}' 2>/dev/null
  else
    printf '○ stopped\n'
    found=0
    for w in "$SESSIONS/$name"/*/; do
      [ -e "$w/.git" ] || continue
      found=1
      printf '\n── %s ──\n' "$(basename "$w")"
      git -C "$w" -c color.ui=always status -sb 2>/dev/null | head -8
    done
    [ "$found" = 0 ] && printf '\n(no worktrees yet)\n'
  fi
  exit 0
fi

[ -z "${TMUX:-}" ] && { echo "Not running tmux!"; exit 1; }

# --- MRU list: live sessions by last-attached, then stopped tasks by dir mtime
live_names=$(tmux list-sessions -F '#{session_name}' 2>/dev/null)
mru=$( {
  tmux list-sessions -F '#{session_last_attached}'$'\t''#{session_name}' 2>/dev/null
  for d in "$SESSIONS"/*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d")
    grep -qxF "$n" <<<"$live_names" && continue   # skip tasks that are already live
    printf '%s\t%s\n' "$(stat -c %Y "$d" 2>/dev/null || echo 0)" "$n"
  done
} | sort -rn -k1 | cut -f2 )

selected=$( printf '%s\n' "$mru" \
  | fzf --tmux --reverse --header='ctrl-n: new task' \
        --bind='ctrl-n:become(new-session)' \
        --preview 'swap-session --preview {}' --preview-window='right:55%:wrap' )

[ -z "$selected" ] && exit 0

if tmux has-session -t "$selected" 2>/dev/null; then
  tmux switch-client -t "$selected"
else
  tmux new-session -ds "$selected" -c "$SESSIONS/$selected"
  tmux switch-client -t "$selected"
fi
