#!/usr/bin/env bash

if [[ -z $TMUX ]]; then
  echo "Not running tmux!"
  exit 1
fi

selected=$(tmux list-sessions -F '#{session_name}' | fzf --tmux --reverse --cycle --header="ctrl-n: new session" --bind="ctrl-n:become(new-session)")

if [[ -z $selected ]]; then
  exit 0
fi

tmux switch-client -t "$selected"
