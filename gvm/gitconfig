# Box-only: git as Ed over https, authenticated by gh's GH_TOKEN.
[user]
	name = Ed Salkeld
	email = edward.salkeld@brightnetwork.co.uk
[credential "https://github.com"]
	helper = !gh auth git-credential
[url "https://github.com/"]
	insteadOf = git@github.com:
	insteadOf = ssh://git@github.com/
# Personal repos use the second token: fine-grained PATs can't span owners.
# Credential rules can't match a path prefix, but they can match a username, so every
# EdwardSalkeld URL gets one; the empty helper drops the gh one inherited from github.com.
[url "https://personal@github.com/EdwardSalkeld/"]
	insteadOf = https://github.com/EdwardSalkeld/
	insteadOf = git@github.com:EdwardSalkeld/
	insteadOf = ssh://git@github.com/EdwardSalkeld/
[credential "https://personal@github.com"]
	helper =
	helper = "!f() { test \"$1\" = get && printf 'username=personal\\npassword=%s\\n' \"$GH_TOKEN_PERSONAL\"; }; f"
# brokensbone is Ed's other GitHub account, so it needs its own token, matched the same way.
[url "https://brokensbone@github.com/brokensbone/"]
	insteadOf = https://github.com/brokensbone/
	insteadOf = git@github.com:brokensbone/
	insteadOf = ssh://git@github.com/brokensbone/
[credential "https://brokensbone@github.com"]
	helper =
	helper = "!f() { test \"$1\" = get && printf 'username=brokensbone\\npassword=%s\\n' \"$GH_TOKEN_BROKENSBONE\"; }; f"
